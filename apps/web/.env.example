# Public (safe in the browser): the project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Development fixture mode ONLY. Reads a local Postgres through the same public.lab_* functions and
# skips login. Refused when NODE_ENV=production or on Vercel.
# LAB_FIXTURE=1
# LAB_FIXTURE_DATABASE_URL=postgres://postgres@127.0.0.1:54329/bench
# LAB_FIXTURE_USER_ID=11111111-1111-1111-1111-111111111111
